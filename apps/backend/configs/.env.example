# Server Configuration
SERVER_HOST=0.0.0.0
SERVER_PORT=8080

# Database Configuration (TursoDB)
DATABASE_URL=libsql://localhost:8080
DATABASE_MAX_OPEN_CONNS=25
DATABASE_MAX_IDLE_CONNS=5
DATABASE_CONN_MAX_LIFETIME=300

# Clerk Authentication
CLERK_JWKS_URL=https://your-project.clerk.accounts.dev/.well-known/jwks.json
CLERK_ISSUER=https://your-project.clerk.accounts.dev

# File Storage (Cloudflare R2)
STORAGE_PROVIDER=local
R2_ACCOUNT_ID=
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# Local File Storage
LOCAL_STORAGE_PATH=./uploads
LOCAL_STORAGE_URL=http://localhost:8080/uploads

# Cache
CACHE_PROVIDER=memory

# Logging
LOG_LEVEL=info
LOG_FORMAT=json

# Application Environment
APP_ENV=development
